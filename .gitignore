# ---------- 运行时中间产物（解包 / 快照 / 截图，随时可清） ----------
work/

# ---------- 发布包与视频（走 Releases，不进仓库） ----------
dist/
*.zip
*.mp4

# ---------- 游戏解包素材：体积大且涉及版权，不进仓库 ----------
# 说明见 README「八、仓库说明」：自己从游戏里解出来再生成
# 注意：只按文件忽略，不忽略目录，这样 .gitkeep 能把目录结构带过来
/assets/map/*.png
/assets/icon/*.png
/assets/icon/**/*.png
/assets/*.png

# Oodle 解压库是 Radiant 的专有二进制，不随仓库分发
# 需要时自己放一份 oo2core_9_win64.dll 到 tools\fsx\ 和 tools\menuextract\
**/oo2core*.dll

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ---------- 本地临时 ----------
*.log
*.tmp
_bgm_loud_backup.mp4
